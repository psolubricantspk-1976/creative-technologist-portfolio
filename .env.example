# GlobalForgeX — environment variables
# Copy to .env.local and fill in before going live. All are optional:
# the site runs with sensible fallbacks (see src/config/site.ts).

# Canonical production origin (used by metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://globalforgex.com

# Monitored support mailbox — powers every "Contact" / support link
NEXT_PUBLIC_SUPPORT_EMAIL=support@globalforgex.com

# Checkout or signup endpoint for "Start evaluation" CTAs.
# While unset, those buttons open the on-site /start flow, which collects the
# program and account size and hands the request to the desk by email.
# NEXT_PUBLIC_CHECKOUT_URL=https://app.globalforgex.com/checkout

# Trader dashboard / member area. Falls back to /#platform.
# NEXT_PUBLIC_LOGIN_URL=https://app.globalforgex.com/login

# Database (used by /api/health)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
